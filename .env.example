# ─────────────────────────────────────────────────────────────────────────────
# Eurocamping · variables de entorno
# Copiá este archivo a .env.local (desarrollo) y cargá los mismos valores en
# Vercel → Project → Settings → Environment Variables (producción).
# ─────────────────────────────────────────────────────────────────────────────

# URL del proyecto Supabase (Dashboard → Project Settings → API → Project URL).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública "anon" o "publishable". Es segura en el navegador: los permisos
# los controla Row Level Security en la base.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio. Se usa en el enlace del mail de recuperación de
# contraseña. En producción: https://www.tu-dominio.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave de servicio (service_role / secret). SECRETA: da acceso total a la base.
# Sólo la usan los scripts de terminal (importador y alta de administradores).
# NO la cargues en Vercel ni la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
